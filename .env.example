# ============================================================================
# Pop Culture — Environment Variables Template
# Copy this file to .env.local and fill in your credentials
# ============================================================================

# --- Admin Panel Password ---
ADMIN_PASSWORD=popculture2026
ADMIN_SESSION_SECRET=replace-with-a-random-32-char-secret

# --- Supabase (Database, Auth & Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gmail SMTP (Order Confirmations & Admin Alerts) ---
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# --- Shiprocket Checkout API ---
SHIPROCKET_ENV=staging
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
SHIPROCKET_SELLER_DOMAIN=localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
